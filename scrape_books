import requests
from bs4 import BeautifulSoup
import pandas as pd
import time

# Store all books here
all_books = []

total_pages = 50

for page in range(1, total_pages + 1):

    # Build the URL for each page
    url = f"http://books.toscrape.com/catalogue/page-{page}.html"

    # Fetch the page
    response = requests.get(url)

    # Check it worked
    if response.status_code != 200:
        print(f"Failed to fetch page {page}")
        continue

    # Parse the HTML
    soup = BeautifulSoup(response.text, "html.parser")

    # Extract all books on this page
    books = soup.select("article.product_pod")

    for book in books:
        title = book.h3.a["title"]
        price = book.select_one(".price_color").text.strip()
        rating = book.select_one(".star-rating")["class"][1]  # e.g. "Three"
        availability = book.select_one(".availability").text.strip()

        all_books.append({
            "title": title,
            "price": price,
            "rating": rating,
            "availability": availability
        })

    print(f"✅ Page {page}/{total_pages} scraped — {len(books)} books found")

    # Be polite: wait 0.5 seconds between requests
    time.sleep(0.5)

# Save everything to a CSV
df = pd.DataFrame(all_books)
df.to_csv("books_all_pages.csv", index=False)

print(f"\n🎉 Done! {len(all_books)} books saved to books_all_pages.csv")
print(df.head())
